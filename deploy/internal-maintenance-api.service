[Unit]
Description=Office Facility Maintenance Management System API (.NET 10)
After=network.target
Wants=docker.service
After=docker.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/internal-maintenance/api
ExecStart=/usr/bin/dotnet /var/www/internal-maintenance/api/InternalMaintenance.Api.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=maintenance-api

# Nạp biến môi trường từ file bảo mật trên VPS
EnvironmentFile=/etc/internal-maintenance/internal-maintenance.env

# Lắng nghe 0.0.0.0:5001 để Nginx Proxy Manager (Docker container) có thể gọi vào
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:5001
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

# Giới hạn tài nguyên để bảo vệ E-commerce Node.js
MemoryMax=500M
MemoryHigh=400M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
