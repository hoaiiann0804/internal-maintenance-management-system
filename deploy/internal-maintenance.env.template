# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION FOR SYSTEMD
# File location on VPS: /etc/internal-maintenance/internal-maintenance.env
# Permissions: chmod 600 /etc/internal-maintenance/internal-maintenance.env
# ==============================================================================

# Database Connection (Kết nối nội bộ SQL Server container trên localhost)
ConnectionStrings__DefaultConnection=Server=127.0.0.1,1433;Database=InternalMaintenanceDb;User Id=sa;Password=YourStrong!ProductionPassword123;TrustServerCertificate=True;Encrypt=False

# JWT Security Settings
Jwt__Key=your-very-strong-production-secret-key-at-least-32-chars
Jwt__Issuer=InternalMaintenanceApi
Jwt__Audience=InternalMaintenanceClient
Jwt__ExpiresInMinutes=60
Jwt__RefreshTokenExpiresInDays=7

# CORS Allowed Origins
Cors__AllowedOrigins__0=https://office-maintenance.vercel.app
Cors__AllowedOrigins__1=http://localhost:5173

# Resend Email Service HTTP API
Resend__ApiKey=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
Resend__FromEmail=no-reply@mail.shopmini.io.vn
Resend__FromName=Maintenance System
Resend__FallbackAdminEmail=admin@shopmini.io.vn
Resend__FallbackManagerEmail=manager@shopmini.io.vn
Resend__FallbackTechnicianEmail=technician@shopmini.io.vn

# Cloudflare R2 Object Storage
R2__AccountId=your_cloudflare_account_id
R2__BucketName=internal-maintenance-attachments
R2__AccessKeyId=your_r2_access_key_id
R2__SecretAccessKey=your_r2_secret_access_key
R2__Endpoint=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2__Region=auto
R2__PresignExpiresMinutes=15
